{
  "name": "magnolia-ui",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/tokens",
    "packages/svelte",
    "packages/react-native",
    "packages/starlight",
    "examples/web"
  ],
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "generate": "node scripts/generate-tokens.mjs",
    "generate:check": "node scripts/generate-tokens.mjs --check",
    "build": "npm run generate && npm run build --workspace @highlanderrobotics/magnolia-tokens && npm run build --workspace @highlanderrobotics/magnolia-svelte && npm run build --workspace @highlanderrobotics/magnolia-react-native",
    "check": "npm run generate:check && npm run check --workspace @highlanderrobotics/magnolia-svelte && npm run check --workspace @highlanderrobotics/magnolia-react-native && npm run check:css",
    "test": "node --test tests/*.test.mjs && vitest run",
    "test:browser": "playwright test",
    "gallery": "vite --config examples/web/vite.config.ts",
    "gallery:build": "vite build --config examples/web/vite.config.ts",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm run build && changeset publish",
    "test:native": "jest --config jest.config.cjs",
    "validate": "npm run build && npm run check && npm test && npm run test:ssr && npm run test:native && npm run gallery:build && npm run test:browser",
    "test:ssr": "node scripts/ssr-smoke.mjs",
    "check:css": "node scripts/check-css.mjs",
    "check:packages": "node scripts/check-packages.mjs",
    "test:consumer": "node scripts/package-smoke.mjs",
    "docs:build": "astro build --root examples/starlight",
    "docs:preview": "astro preview --root examples/starlight --host 127.0.0.1 --port 4174"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@astrojs/starlight": "^0.42.11",
    "@axe-core/playwright": "^4.11.0",
    "@changesets/cli": "^2.29.0",
    "@playwright/test": "^1.56.0",
    "@react-native/babel-preset": "^0.81.5",
    "@sveltejs/package": "^2.5.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.0",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react-native": "^13.3.0",
    "@testing-library/svelte": "^5.2.0",
    "@types/react": "^19.1.0",
    "@types/react-test-renderer": "^19.1.0",
    "@vitest/coverage-v8": "^3.2.0",
    "ajv": "^8.20.0",
    "astro": "^7.4.11",
    "axe-core": "^4.11.0",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.6.0",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-svelte": "^3.4.0",
    "publint": "^0.3.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-test-renderer": "19.1.0",
    "svelte": "^5.39.0",
    "svelte-check": "^4.3.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
