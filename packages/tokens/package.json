    "./tokens.json": "./tokens.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "homepage": "https://github.com/HighlanderRobotics/magnolia-ui#readme",
  "bugs": {
    "url": "https://github.com/HighlanderRobotics/magnolia-ui/issues"
