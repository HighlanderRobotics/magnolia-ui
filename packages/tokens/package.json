{
  "name": "@highlanderrobotics/magnolia-tokens",
  "version": "0.2.0",
  "type": "module",
  "description": "Magnolia UI tokens design system",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HighlanderRobotics/magnolia-ui.git",
    "directory": "packages/tokens"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist",
    "tokens.css",
    "tokens.json",
    "schema.json",
    "README.md",
